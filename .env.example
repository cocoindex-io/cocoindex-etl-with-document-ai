# Engine state (local)
COCOINDEX_DB=./cocoindex.db

# Vector store for the embeddings
POSTGRES_URL=postgres://cocoindex:cocoindex@localhost/cocoindex

# Google Document AI — fill these in (see README)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_CLOUD_PROCESSOR_ID=

# Fallback to CPU for operations not supported by MPS on Mac. No-op elsewhere.
PYTORCH_ENABLE_MPS_FALLBACK=1
